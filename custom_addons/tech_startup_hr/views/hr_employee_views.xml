<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_tech" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.tech</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Hồ sơ Công nghệ" name="tech_profile">
                    <group>
                        <group>
                            <field name="main_tech_stack"/>
                            <field name="seniority_level"/>
                        </group>
                        <group>
                            <field name="github_profile" widget="url"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>